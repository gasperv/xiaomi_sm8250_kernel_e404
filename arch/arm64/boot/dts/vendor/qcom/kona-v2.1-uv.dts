			};
			qcom,gpu-pwrlevel@6 {
				qcom,gpu-freq = <150000000>;
				qcom,bus-freq-ddr7 = <2>;
				qcom,bus-min-ddr7 = <1>;
				qcom,bus-max-ddr7 = <3>;
				qcom,bus-freq-ddr8 = <2>;
